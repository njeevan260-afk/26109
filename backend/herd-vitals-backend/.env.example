SUPABASE_URL=https://your-project.supabase.co
# Prefer the modern backend-only sb_secret_ key. The legacy service-role key
# remains supported as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=your-server-only-secret-key
DEVICE_INGESTION_KEY=replace-with-a-long-random-device-key
# Comma-separated browser origins allowed to call FastAPI.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional for Vercel previews, for example: ^https://.*-your-account\.vercel\.app$
# CORS_ORIGIN_REGEX=
# MODEL_ARTIFACT_PATH=C:\absolute\path\to\mastitis-risk-model.joblib
