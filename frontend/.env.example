# Use "auto" in local development to call port 8000 on whichever hostname
# opened the frontend (localhost on the computer or its LAN IP on a phone).
VITE_API_URL="auto"
# Public browser origin used in Supabase email links. Use your production URL
# when deployed, or this computer's LAN URL when testing links from a phone.
VITE_PUBLIC_SITE_URL="auto"

# Public browser credentials from Supabase Project Settings > API Keys.
# Never put the service-role key in this frontend file.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
